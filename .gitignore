node_modules
dist
*.local
.DS_Store

# Your home's configuration (pushed to the TV or put in Home Assistant; see docs/configuration.md)
/calm-tv.json

# Video clips stay out of git: they're large, and stock clips may not be republished.
# They still build into your own app from this folder. To share a clip you have the rights to,
# whitelist it and its thumbnail by name, e.g.:
#   !src/videos/01-my-clip.mp4
#   !src/videos/01-my-clip.jpg
src/videos/*
!src/videos/README.md
!src/videos/00-mountain-lake-sunset.mp4
!src/videos/00-mountain-lake-sunset.jpg
!src/videos/01-stylized-forest-brook.mp4
!src/videos/01-stylized-forest-brook.jpg

# Photos: only ones we own are committed (others still build into your own app from this folder).
src/wallpapers/*
!src/wallpapers/README.md
!src/wallpapers/00-mountain-lake-sunset.jpg
!src/wallpapers/01-stylized-forest-brook.jpg

# Demo mode's placeholder camera view and album cover (made for the project).
src/demo-media/*
!src/demo-media/doorbell-camera.mp4
!src/demo-media/album-echoes.jpg

# Local tools and design drafts
.claude/
mockups/
